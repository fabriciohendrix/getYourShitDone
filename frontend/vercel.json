{
  "rewrites": [
    {
      "source": "/insurances-dashboard/",
      "destination": "https://insurance-dashboard-ashy.vercel.app/"
    },
    {
      "source": "/insurances-dashboard/:path*",
      "destination": "https://insurance-dashboard-ashy.vercel.app/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
